# =============================================================================
# Izwi Audio - Environment Variables
# =============================================================================
# Copy this file to .env and adjust as needed

# Server Configuration
IZWI_HOST=0.0.0.0
IZWI_PORT=8080
IZWI_BACKEND=auto
IZWI_MAX_BATCH_SIZE=8
IZWI_NUM_THREADS=8
IZWI_MAX_CONCURRENT=100
IZWI_TIMEOUT=300
IZWI_CORS=0
# IZWI_CORS_ORIGINS=http://localhost:3000,https://example.com
IZWI_NO_UI=0
IZWI_UI_DIR=ui/dist

# Committed prefix reuse (opt-in; requires an explicit namespace salt, and a
# model family whose cache contract permits shared spans)
# IZWI_ENABLE_PREFIX_CACHING=1
# IZWI_MANAGED_PREFIX_CACHE_SALT=production/default
# IZWI_MAX_PREFIX_CACHE_PAGES=128

# Scheduler-level chunked prefill (opt-in; currently Qwen3.8 chat only)
# IZWI_ENABLE_CHUNKED_PREFILL=1
# IZWI_CHUNKED_PREFILL_THRESHOLD=192

# Qwen3.8 native multi-token prediction (MTP) is enabled at depth one by
# default on every backend. Set IZWI_QWEN38_MTP=0 to disable it. Increase the
# draft-token value only after validating acceptance and throughput on the
# target model/device; supported values are 1..=3.
IZWI_QWEN38_MTP=1
IZWI_QWEN38_MTP_DRAFT_TOKENS=1

# Legacy compatibility aliases (prefer the canonical names above)
# MAX_CONCURRENT_REQUESTS=100
# REQUEST_TIMEOUT_SECS=300

# HuggingFace Configuration
# Set your HuggingFace token for private models (optional)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Model Storage
# HF_HOME=/app/models/huggingface
# TRANSFORMERS_CACHE=/app/models/huggingface

# Logging
RUST_LOG=info
PYTHONUNBUFFERED=1

# Optional analytics (Aptabase for Tauri desktop shell)
# Leave empty to disable analytics transport at runtime
# APTABASE_APP_KEY=A-XXXXXXXXXXXXXXX

# CUDA Configuration (for GPU builds)
# NVIDIA_VISIBLE_DEVICES=all
# CUDA_VISIBLE_DEVICES=0
