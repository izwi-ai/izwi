# =============================================================================
# Izwi Audio - Docker Compose settings
# =============================================================================
# Copy this file to .env next to docker-compose.yml; Compose reads it
# automatically. The server only sees what docker-compose.yml passes in. Other
# server variables (docs/dev/env/) go under `environment:` in a compose file of
# your own, added to COMPOSE_FILE.

# --- Production ---------------------------------------------------------------
# Uncomment both lines to add docker-compose.prod.yml to every compose command.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PATH_SEPARATOR=:

# API key: 16-4096 printable characters without spaces. Required in
# production, optional in development. Generate one with
#   openssl rand -hex 32
# Clients send it as "Authorization: Bearer <key>"; the web UI asks for it.
IZWI_API_KEY=

# Production only: the host address the port is published on. 127.0.0.1 suits
# a reverse proxy on this host; 0.0.0.0 serves plain HTTP to the network.
# IZWI_PUBLISH_ADDR=127.0.0.1

# --- Development and production ----------------------------------------------
# Host port; the container always listens on 8080.
# IZWI_PORT=8080

# Extra Host names to answer, comma-separated: a compose service name such as
# "izwi" for other containers on the network, or your domain in production.
# IZWI_ALLOWED_HOSTS=

# Log filter (tracing EnvFilter syntax).
# RUST_LOG=izwi_server=info,izwi_gateway=info,izwi_db=info,izwi_core=info,tower_http=warn

# --- CUDA image build (docker compose --profile cuda) -------------------------
# CUDA_COMPUTE_CAP=80
# IZWI_CUDA_FEATURES=cuda,cudnn
